# Frontend environment. Copy to `.env.local` and adjust as needed.

# Base URL for the SALA API.
# Leave as the relative default to use the Vite dev proxy in `vite.config.ts`,
# which forwards /api to the Django backend and avoids CORS entirely.
# Set an absolute URL (e.g. http://127.0.0.1:8000/api/v1) to bypass the proxy —
# the backend must then allow this origin via CORS_ALLOWED_ORIGINS.
VITE_API_URL=/api/v1

# Where the dev proxy forwards /api. Must be the Django runserver address.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Port for the Vite dev server. If the port is taken Vite increments it, and the
# proxy keeps working on the new port.
VITE_PORT=5173
